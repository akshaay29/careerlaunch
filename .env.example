# CareerLaunch configuration template. Copy to `.env` (repo root or api/) for local dev.
# NEVER commit real values. Each key notes where it lives in production:
#   [Render env]      api service environment (render.yaml, sync: false = set in dashboard)
#   [Vercel env]      web project environment variables
#   [GitHub secrets]  repository Actions secrets (release workflow)
#   [Supabase Vault]  secrets read inside Postgres by pg_cron/pg_net: `drain_url`, `drain_secret`
#                     (operator step, see README "Background jobs")
# Local values below target the Supabase CLI stack (`npx supabase start`).

# ---------------------------------------------------------------- api (Settings)
# [Render env] local | ci | prod
ENVIRONMENT=local
# [Render env] DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# [Render env] Postgres via the Supavisor SESSION pooler (port 5432) in prod -- never the
# transaction pooler (6543) or the IPv6 direct host. Local: Supabase CLI Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# [Render env] The Vercel production origin, e.g. https://careerlaunch.vercel.app (CORS allow-list)
WEB_ORIGIN=http://localhost:3000
# [Render env] Extra CORS origins, comma-separated (localhost for local dev)
CORS_EXTRA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- auth (AD-5, Story 1.3)
# [Render env] Supabase project URL. Tokens must have iss == <SUPABASE_URL>/auth/v1; asymmetric
# signing keys are fetched from <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Local: the CLI stack.
SUPABASE_URL=http://127.0.0.1:54321
# [Render env] Legacy HS256 JWT secret (Supabase dashboard: JWT Keys > Legacy JWT secret). Needed
# only while the project still signs with it; the local CLI does. Empty = HS256 tokens rejected.
# Local CLI value: see `npx supabase status` (JWT secret).
SUPABASE_JWT_SECRET=
# NOT here: the Google OAuth client id/secret live only in Supabase Auth settings (hosted) and in
# supabase/.env for the local CLI (SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / _SECRET, gitignored).

# ---------------------------------------------------------------- background jobs (AD-4)
# [Render env] + [GitHub secrets] + [Supabase Vault `drain_secret`] Bearer secret for /internal/*.
# Generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Empty = every
# /internal request is rejected. The SAME value goes in all three places.
DRAIN_SECRET=
# [Render env] Old secret, accepted during rotation only; empty otherwise.
DRAIN_SECRET_PREVIOUS=
# [Render env] Hard cap on one drain in seconds (max 240).
DRAIN_TIMEOUT_SECONDS=240
# [Render env] GET /internal/health returns 503 when the last drain is older than this.
DRAIN_STALE_AFTER_MINUTES=15
# [GitHub secrets] Public base URL of the api for health-drain.yml, e.g. https://careerlaunch-api.onrender.com
API_BASE_URL=

# ---------------------------------------------------------------- release workflow
# [GitHub secrets] Session-pooler URL (port 5432) used ONLY by `alembic upgrade head` in
# migrate-deploy.yml. Locally Alembic falls back to DATABASE_URL when this is unset.
MIGRATION_DATABASE_URL=
# [GitHub secrets] Render deploy hook URL for the api service (contains a secret key)
RENDER_DEPLOY_HOOK_URL=
# [GitHub secrets] Render API key + service id (srv-...), used to wait until the deploy is live
RENDER_API_KEY=
RENDER_SERVICE_ID=
# [GitHub secrets] Vercel token + ids for `vercel deploy --prod`
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ---------------------------------------------------------------- web
# [Vercel env] Public base URL of the api (the Render service URL in prod). Put it in web/.env.local locally.
NEXT_PUBLIC_API_URL=http://localhost:8000
# [Vercel env] Supabase project URL and anon (publishable) key, for Auth only (web never reads
# data through Supabase). Local: `npx supabase status` (API URL, anon key) -> web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
