# CareerLaunch configuration template. Copy to `.env` (repo root or api/) for local dev.
# NEVER commit real values. Each key notes where it lives in production:
#   [Render env]      api service environment (render.yaml, sync: false = set in dashboard)
#   [Vercel env]      web project environment variables
#   [GitHub secrets]  repository Actions secrets (release workflow)
#   [Supabase Vault]  secrets read inside Postgres by pg_cron/pg_net: `drain_url`, `drain_secret`
#                     (operator step, see README "Background jobs")
# Local values below target the Supabase CLI stack (`npx supabase start`).

# ---------------------------------------------------------------- api (Settings)
# [Render env] local | ci | prod
ENVIRONMENT=local
# [Render env] DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# [Render env] Postgres via the Supavisor SESSION pooler (port 5432) in prod -- never the
# transaction pooler (6543) or the IPv6 direct host. Local: Supabase CLI Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# [Render env] The Vercel production origin, e.g. https://careerlaunch.vercel.app (CORS allow-list)
WEB_ORIGIN=http://localhost:3000
# [Render env] Extra CORS origins, comma-separated (localhost for local dev)
CORS_EXTRA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- auth (AD-5, Story 1.3)
# [Render env] Supabase project URL. Tokens must have iss == <SUPABASE_URL>/auth/v1; asymmetric
# signing keys are fetched from <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Local: the CLI stack.
SUPABASE_URL=http://127.0.0.1:54321
# [Render env] Legacy HS256 JWT secret (Supabase dashboard: JWT Keys > Legacy JWT secret). Needed
# only while the project still signs with it; the local CLI does. Empty = HS256 tokens rejected.
# Local CLI value: see `npx supabase status` (JWT secret).
SUPABASE_JWT_SECRET=
# NOT here: the Google OAuth client id/secret live only in Supabase Auth settings (hosted) and in
# supabase/.env for the local CLI (SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / _SECRET, gitignored).

# ---------------------------------------------------------------- file storage (Story 1.5)
# [Render env] + [GitHub secrets] Supabase service-role (secret) key, used ONLY by the api to
# reach the private Storage bucket (and by scripts/ensure_bucket.py in migrate-deploy.yml).
# Never in web, never in a URL. Required whenever the real Storage adapter is used.
# Local CLI value: `npx supabase status` (service_role key / secret key).
SUPABASE_SERVICE_ROLE_KEY=
# [Render env] (+ optional GitHub variable STORAGE_BUCKET) The PRIVATE bucket holding every
# Student file at <owner_id>/<kind>/<uuid>. Local: declared in supabase/config.toml.
STORAGE_BUCKET=private
# [Render env] Resume versions a Student may keep; one more upload is refused (409).
RESUME_MAX_VERSIONS=10
# [Render env] Documents a Student may keep; one more upload is refused (409).
DOCUMENT_MAX_COUNT=20

# ---------------------------------------------------------------- provider keys (AD-6, Story 2.2)
# [Render env] Master key(s) encrypting Students' Provider Keys: "1:<base64 32 bytes>[,2:<...>]".
# Generate: python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"
# Keep an offline copy in the owner's password manager; see README "Credential master key"
# for rotation. Empty = saving a Provider Key fails with 503 (the api still starts).
CREDENTIALS_MASTER_KEYS=
# [Render env] Value of the x-apify-integration-platform header sent on every Apify request.
APIFY_INTEGRATION_PLATFORM=careerlaunch
# [Render env] Apify API base URL (only changed for tests).
APIFY_API_BASE=https://api.apify.com

# ---------------------------------------------------------------- collection (Story 2.3, AD-12)
# [Render env] Allowlisted Apify actors, comma-separated, in order: the first one runs (reorder
# to switch to the fallback). No cookie or login input is ever set.
APIFY_ACTOR_ALLOWLIST=curious_coder/linkedin-jobs-scraper,harvestapi/linkedin-job-search
# [Render env] Hours between a Student's scheduled collection runs (at least 24).
COLLECT_INTERVAL_HOURS=24
# [Render env] Scheduled runs happen at this hour (0-23) in the Student's time zone.
COLLECT_LOCAL_HOUR=6
# [Render env] Caps set on every Apify run (maxItems, maxTotalChargeUsd in USD).
COLLECT_MAX_ITEMS=100
COLLECT_MAX_CHARGE_USD=0.25
# [Render env] Platform kill switch: false refuses every new provider run.
PROVIDER_RUNS_ENABLED=true
# [Render env] Spend caps (Story 2.4). Default monthly cap for a Student without their own caps
# (USD; the default per-run cap is COLLECT_MAX_CHARGE_USD).
DEFAULT_MONTHLY_CAP_USD=4.00
# [Render env] Price per result used for the run estimate (max items x price, USD).
APIFY_PRICE_PER_ITEM_USD=0.001
# [Render env] Optional platform-wide monthly cap over every Student's committed spend (USD).
# Empty = off.
PLATFORM_MONTHLY_CAP_USD=
# [Render env] Expiry and capacity (Story 2.5). A Listing unseen for LISTING_UNSEEN_DAYS (at
# least 7) days AND LISTING_UNSEEN_RUNS (at least 1) succeeded provider runs since is expired;
# expired Listings are deleted after LISTING_PURGE_GRACE_DAYS; active Listings above
# LISTING_POOL_CAP are evicted (lowest relevance, oldest first; never pinned ones).
LISTING_UNSEEN_DAYS=14
LISTING_UNSEEN_RUNS=3
LISTING_PURGE_GRACE_DAYS=30
LISTING_POOL_CAP=30000
# [Render env] Free database quota in bytes (500 MiB) and the percentage that raises a
# `listings.quota_alert` ops event in the daily check.
DB_QUOTA_BYTES=524288000
DB_QUOTA_ALERT_PERCENT=80
# [Render env] Keyword search (Story 2.6): the least trigram similarity (0.1 to 0.9) of the query
# to a Listing's title and company that still counts as a match when full-text finds nothing.
SEARCH_TRIGRAM_THRESHOLD=0.35
# [Render env] Stored Match Scores (Story 3.2): at most this many (1 to 5000) of a Student's
# matching pool Listings are scored and stored, newest first; their own manual Listings are added
# beyond the cap (a Student with no Preferences filter and no skill has no candidates).
MATCH_CANDIDATE_CAP=500
# [local only] The owner's Apify token, used ONLY by api/scripts/seed_pool.py. Never in Render.
SEED_APIFY_TOKEN=

# ---------------------------------------------------------------- background jobs (AD-4)
# [Render env] + [GitHub secrets] + [Supabase Vault `drain_secret`] Bearer secret for /internal/*.
# Generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Empty = every
# /internal request is rejected. The SAME value goes in all three places.
DRAIN_SECRET=
# [Render env] Old secret, accepted during rotation only; empty otherwise.
DRAIN_SECRET_PREVIOUS=
# [Render env] Hard cap on one drain in seconds (max 240).
DRAIN_TIMEOUT_SECONDS=240
# [Render env] GET /internal/health returns 503 when the last drain is older than this.
DRAIN_STALE_AFTER_MINUTES=15
# [GitHub secrets] Public base URL of the api for health-drain.yml, e.g. https://careerlaunch-api.onrender.com
API_BASE_URL=

# ---------------------------------------------------------------- release workflow
# [GitHub secrets] SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (same values as Render) are also
# needed by migrate-deploy.yml to run scripts/ensure_bucket.py.
# [GitHub secrets] Session-pooler URL (port 5432) used ONLY by `alembic upgrade head` in
# migrate-deploy.yml. Locally Alembic falls back to DATABASE_URL when this is unset.
MIGRATION_DATABASE_URL=
# [GitHub secrets] Render deploy hook URL for the api service (contains a secret key)
RENDER_DEPLOY_HOOK_URL=
# [GitHub secrets] Render API key + service id (srv-...), used to wait until the deploy is live
RENDER_API_KEY=
RENDER_SERVICE_ID=
# [GitHub secrets] Vercel token + ids for `vercel deploy --prod`
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ---------------------------------------------------------------- web
# [Vercel env] Public base URL of the api (the Render service URL in prod). Put it in web/.env.local locally.
NEXT_PUBLIC_API_URL=http://localhost:8000
# [Vercel env] Supabase project URL and anon (publishable) key, for Auth only (web never reads
# data through Supabase). Local: `npx supabase status` (API URL, anon key) -> web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
