{
  "openapi": "3.1.0",
  "info": {
    "title": "CareerLaunch API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/public/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/me": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Get Admin Me",
        "operationId": "getAdminMe",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Get Me",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/consents": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "List Consents",
        "operationId": "listConsents",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentOverview"
                }
              }
            }
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/consents/{purpose}": {
      "put": {
        "tags": [
          "accounts"
        ],
        "summary": "Grant Consent",
        "operationId": "grantConsent",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "purpose",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ConsentPurpose"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentGrant"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentStatus"
                }
              }
            }
          },
          "409": {
            "description": "The consent text version changed",
            "content": {
              "application/problem+json": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "accounts"
        ],
        "summary": "Revoke Consent",
        "operationId": "revokeConsent",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "purpose",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ConsentPurpose"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/resumes": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "Upload Resume",
        "description": "Upload a new Resume version. The type is read from the file's content. It becomes\nthe active version only when the Student has no active Resume.",
        "operationId": "uploadResume",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_uploadResume"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeVersion"
                }
              }
            }
          },
          "409": {
            "description": "The version cap is reached",
            "content": {
              "application/problem+json": {}
            }
          },
          "413": {
            "description": "The file is larger than 5 MB",
            "content": {
              "application/problem+json": {}
            }
          },
          "415": {
            "description": "The file is not a PDF or DOCX",
            "content": {
              "application/problem+json": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "List Resumes",
        "operationId": "listResumes",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/resumes/{resume_id}/activate": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "Activate Resume",
        "operationId": "activateResume",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "resume_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Resume Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeVersion"
                }
              }
            }
          },
          "404": {
            "description": "No such Resume version for this Student",
            "content": {
              "application/problem+json": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/resumes/{resume_id}/download": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "Get Resume Download",
        "description": "A signed URL (5 minutes or less) that downloads the file as an attachment.",
        "operationId": "getResumeDownload",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "resume_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Resume Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeDownload"
                }
              }
            }
          },
          "404": {
            "description": "No such Resume version for this Student",
            "content": {
              "application/problem+json": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/resumes/{resume_id}": {
      "delete": {
        "tags": [
          "profile"
        ],
        "summary": "Delete Resume",
        "description": "Delete a version. Its file is removed by a background job started right after the\nresponse. Deleting the active version leaves no version active.",
        "operationId": "deleteResume",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "resume_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Resume Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such Resume version for this Student",
            "content": {
              "application/problem+json": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/skill-profile": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "Get Skill Profile",
        "operationId": "getSkillProfile",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillProfileOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      },
      "patch": {
        "tags": [
          "profile"
        ],
        "summary": "Edit Skill Profile",
        "description": "Add skills (a vocabulary term becomes a skill, anything else a custom skill), remove\nskills by id, or remove custom skills. Edits are kept when a new Resume is extracted.",
        "operationId": "editSkillProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SkillProfileEdit"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillProfileOut"
                }
              }
            }
          },
          "422": {
            "description": "Invalid terms, ids or too many custom skills",
            "content": {
              "application/problem+json": {}
            }
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/skill-profile/reset": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "Reset Skill Profile",
        "description": "Reset to extracted: drop every added, removed and custom skill.",
        "operationId": "resetSkillProfile",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillProfileOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ]
      }
    },
    "/api/v1/skills": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "Suggest Skills",
        "description": "Up to 20 vocabulary skills matching ``q`` (prefix matches first), for autocomplete.",
        "operationId": "suggestSkills",
        "security": [
          {
            "SupabaseAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SkillRef"
                  },
                  "title": "Response Suggestskills"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_uploadResume": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "A PDF or DOCX file of 5 MB or less"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_uploadResume"
      },
      "ConsentGrant": {
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "ConsentGrant",
        "description": "The version of the text the Student was shown and agreed to."
      },
      "ConsentOverview": {
        "properties": {
          "purposes": {
            "items": {
              "$ref": "#/components/schemas/ConsentStatus"
            },
            "type": "array",
            "title": "Purposes"
          },
          "rights": {
            "$ref": "#/components/schemas/RightsNotice"
          },
          "notice_version": {
            "type": "string",
            "title": "Notice Version"
          }
        },
        "type": "object",
        "required": [
          "purposes",
          "rights",
          "notice_version"
        ],
        "title": "ConsentOverview"
      },
      "ConsentPurpose": {
        "type": "string",
        "enum": [
          "provider_runs",
          "pool_contribution"
        ],
        "title": "ConsentPurpose",
        "description": "Phase 1 purposes. Phase 2 adds ``linkedin_link``, ``outreach`` and ``llm_drafting``\n(with a migration widening ``consents_purpose_check``)."
      },
      "ConsentStatus": {
        "properties": {
          "purpose": {
            "$ref": "#/components/schemas/ConsentPurpose"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Body"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "granted",
              "revoked",
              "none",
              "outdated"
            ],
            "title": "Status"
          },
          "granted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Granted At"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          }
        },
        "type": "object",
        "required": [
          "purpose",
          "title",
          "body",
          "version",
          "status",
          "granted_at",
          "revoked_at"
        ],
        "title": "ConsentStatus",
        "description": "One purpose: the text to show (plain-text paragraphs) and the Student's status on it.\n\n``status``: ``granted`` (active on the current version), ``outdated`` (active on an older\nversion: agree again), ``revoked`` (withdrawn) or ``none`` (never agreed)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "admin"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "Me",
        "description": "The calling account. ``role`` comes from the database, never from the token."
      },
      "ProfileSkill": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "source": {
            "type": "string",
            "enum": [
              "extracted",
              "added"
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "source"
        ],
        "title": "ProfileSkill",
        "description": "An effective skill. ``source`` is ``extracted`` when the active Resume mentions it,\nelse ``added`` (the Student added it)."
      },
      "ResumeDownload": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "url",
          "expires_at"
        ],
        "title": "ResumeDownload",
        "description": "A signed URL that downloads the file as an attachment; it stops working at\n``expires_at`` (5 minutes or less)."
      },
      "ResumeList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ResumeVersion"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ResumeList",
        "description": "Newest first. Pass ``next_cursor`` as ``cursor`` to get the next page (null = done)."
      },
      "ResumeVersion": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            ],
            "title": "Content Type"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "content_type",
          "size_bytes",
          "is_active",
          "created_at"
        ],
        "title": "ResumeVersion",
        "description": "One uploaded Resume version. ``filename`` is untrusted text: render it as plain text."
      },
      "RightsNotice": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "RightsNotice",
        "description": "The India DPDP Act rights notice, shown with the consent texts (plain text)."
      },
      "SkillProfileEdit": {
        "properties": {
          "add": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Add"
          },
          "remove": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Remove"
          },
          "remove_custom": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Remove Custom"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SkillProfileEdit",
        "description": "``add``: terms (a vocabulary match becomes a skill, anything else a custom skill);\n``remove``: skill ids; ``remove_custom``: custom terms."
      },
      "SkillProfileOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "pending",
              "ready",
              "unreadable",
              "failed"
            ],
            "title": "Status"
          },
          "resume_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Id"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/ProfileSkill"
            },
            "type": "array",
            "title": "Skills"
          },
          "removed": {
            "items": {
              "$ref": "#/components/schemas/SkillRef"
            },
            "type": "array",
            "title": "Removed"
          },
          "custom": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Custom"
          },
          "education": {
            "items": {
              "type": "string"
            },
